{
  "name": "perceive-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Perceive – local, on-device vision inference Chrome extension (MV3). Phase 1 scaffold.",
  "scripts": {
    "fetch-models": "node fetch-models.js",
    "build": "node build.js",
    "build:test-hooks": "TEST_HOOKS=1 node build.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "TEST_HOOKS=1 node build.js && node verify.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "chrome-remote-interface": "^0.33.3",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
}