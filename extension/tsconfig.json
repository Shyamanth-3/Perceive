{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "jest", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // Dev 2/Dev 4 vendored files (src/dev2-vendor, src/dev4-vendor) are
    // real, unmodified upstream .js — imported directly from .ts (dev2-
    // integration.ts, orchestrator.ts, etc.) rather than reimplemented.
    // allowJs lets tsc see them; checkJs stays off so vendored code isn't
    // held to this project's own strict-mode bar.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "tests/**/*.ts", "build.js", "verify.js"]
}